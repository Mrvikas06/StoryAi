{
  "name": "storytime-app",
  "version": "1.0.0",
  "description": "Child-friendly storytelling app with bilingual TTS",
  "main": "server.js",
  "scripts": {
    "start": "node server.js",
    "dev": "nodemon server.js",
    "build": "cd frontend && npm install && npm run build",
    "deploy:cloudflare": "wrangler deploy",
    "dev:cloudflare": "wrangler dev",
    "deploy:render": "git push render main",
    "health-check": "node scripts/health-check.js",
    "prestart": "node scripts/health-check.js",
    "dev:backend": "cd backend && npm run dev",
    "dev:frontend": "cd frontend && npm run dev",
    "test": "npm --prefix backend test"
  },
  "engines": {
    "node": ">=18.0.0"
  },
  "dependencies": {
    "cors": "^2.8.5",
    "dotenv": "^16.4.7",
    "express": "^4.18.2",
    "groq-sdk": "^1.1.2",
    "mongoose": "^8.9.5"
  }
}
